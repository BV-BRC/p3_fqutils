{
  "id": "FastqUtils",
  "label": "Fastq Utilites",
  "script": "App-FastqUtils",
  "description": "Useful common processing of fastq files",
    "default_memory": "10G",
    "default_cpu": 2,
    "default_runtime": 36000,
  "parameters": [
    {
        "id": "reference_genome_id",
        "required": 0,
        "default": null,
        "label": "Reference genome ID",
        "desc": "Reference genome ID",
        "type": "string"
    },
    {
      "id": "paired_end_libs",
      "type": "group",
      "allow_multiple": false,
      "required": 0,
      "default": null,
      "group": [
        {
          "id": "read1",
          "required": 1,
          "label": "Read file 1",
          "desc": "FASTQ file of reads",
          "wstype": "ReadFile",
          "type": "wstype"
        },
        {
          "id": "read2",
          "required": 0,
          "label": "Read file 2",
          "desc": "FASTQ file of reads",
          "wstype": "ReadFile",
          "type": "wstype"
        },
        {
          "default": "infer",
          "desc": "Sequencing platform used to generate the read library",
          "enum": [
            "infer",
            "illumina",
            "pacbio",
            "pacbio_hifi",
            "nanopore"
          ],
          "id": "platform",
          "label": "Sequencing Platform",
          "required": 0,
          "type": "enum"
        }
      ]
    },
    {
      "id": "single_end_libs",
      "type": "group",
      "allow_multiple": false,
      "required": 0,
      "default": null,
      "group": [
        {
          "id": "read",
          "required": 1,
          "label": "Read file",
          "desc": "FASTQ file of reads",
          "wstype": "ReadFile",
          "type": "wstype"
        },
        {
          "default": "infer",
          "desc": "Sequencing platform used to generate the read library",
          "enum": [
            "infer",
            "illumina",
            "pacbio",
            "pacbio_hifi",
            "nanopore"
          ],
          "id": "platform",
          "label": "Sequencing Platform",
          "required": 0,
          "type": "enum"
        }
      ]
    },
    {
	"id": "srr_libs",
	"type": "group",
	"allow_multiple": true,
	"required": 0,
	"default" : null,
	"group": [
	    {
		"id": "srr_accession",
		"required": 1,
		"label": "SRR Accession",
		"desc": "SRA Sample accession with SRR prefix",
		"type": "string"
	    }
	]
    },
    {
      "id": "output_path",
      "label": "Output Folder",
      "required": 1,
      "default": null,
      "desc": "Path to which the output will be written. Defaults to the directory containing the input data. ",
      "type": "folder"
    },
    {
      "id": "output_file",
      "label": "File Basename",
      "required": 1,
      "default": null,
      "desc": "Basename for the generated output files. Defaults to the basename of the input data.",
      "type": "wsid"
    },
    {
        "id": "recipe",
        "label": "Recipe",
        "allow_multiple": true,
        "required": 1,
        "default": [],
        "type": "list"
    },
    {
          "id": "species_common_name",
          "label": "Species Common Name",
          "required": 0,
          "type": "enum",
          "default": null,
          "desc": "Species common name for desired host species",
          "enum": [
            "Mouse",
            "Rat",
            "Pig",
            "Cow",
            "Chicken",
            "Dog",
            "Cat",
            "Zebrafish",
            "Fruit fly",
            "C. elegans",
            "Rhesus macaque",
            "Crab-eating macaque",
            "Olive baboon",
            "Vervet",
            "Marmoset",
            "Chimpanzee",
            "Bonobo",
            "Western lowland gorilla",
            "Sumatran orangutan",
            "Bornean orangutan",
            "Sheep",
            "Goat",
            "Horse",
            "Water buffalo",
            "Turkey",
            "Duck",
            "Rabbit",
            "Little brown bat",
            "Big brown bat",
            "Egyptian fruit bat",
            "Black flying fox",
            "Common vampire bat",
            "Pale spear-nosed bat",
            "Pallas's mastiff bat",
            "Greater horseshoe bat",
            "Natal long-fingered bat",
            "Red fox",
            "Ferret",
            "Human"
          ]
        },
        {
          "id": "aligner",
          "label": "Aligner",
          "required": 0,
          "type": "enum",
          "default": null,
          "desc": "Desired aligner to use with Hostile (bowtie2 for short reads, minimap2 for long reads)",
          "enum": [
            "bowtie2",
            "minimap2"
          ]
        }
  ]
}
